# ==============================================================================
# JARVIS Environment Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit real API keys or sensitive credentials to version control.
# ==============================================================================

# Environment: development | production | testing
JARVIS_ENV=development

# Operating Mode: offline | hybrid | online
# offline: No network calls; strictly local AI, memory, and tools.
# hybrid: Local-first; network allowed ONLY for explicitly permitted operations.
# online: Cloud AI & online capabilities permitted when explicitly authorized.
JARVIS_MODE=offline

# Safety Settings
SAFE_MODE=true
REQUIRE_DOUBLE_CONFIRMATION_FOR_CRITICAL=true

# AI Provider Configuration (Phase 4 - Local-First & Privacy-First)
# Options: AI_MODE=local | online | hybrid
# Options: AI_PROVIDER=local | openrouter | none
AI_ENABLED=true
AI_MODE=local
AI_PROVIDER=local
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=500

# Local AI Endpoint (Ollama / llama.cpp / LM Studio)
# NOTE: JARVIS does NOT auto-download models. Recommended lightweight model for 8GB RAM: qwen2.5:1.5b
LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen2.5:1.5b

# Cloud AI Providers (Dual Provider: Gemini Primary + OpenRouter Backup)
# Requires 'allow cloud_ai' permission in JARVIS
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Voice Settings (Phase 3+)
WAKE_PHRASE=jarvis
INACTIVITY_TIMEOUT_SECONDS=60.0
TTS_ENGINE=pyttsx3
STT_ENGINE=local_whisper
LISTENING_TIMEOUT_SECONDS=10.0
COMMAND_TIMEOUT_SECONDS=30.0

# Storage & Paths
DATA_DIR=data
DB_PATH=data/jarvis.db
LOG_DIR=data/logs
LOG_LEVEL=INFO
